# ---------- 阿里云百炼（三者共用一个 Key）----------
DASHSCOPE_API_KEY=sk-xxxxxxxx

# ---------- 对话（Qwen，OpenAI 兼容）----------
CHAT_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
CHAT_MODEL=qwen-plus
CHAT_TEMPERATURE=0
CHAT_ENABLE_THINKING=false

# ---------- Embedding（Qwen，OpenAI 兼容）----------
EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBEDDING_MODEL=text-embedding-v4
EMBEDDING_DIM=1024
EMBEDDING_BATCH_SIZE=10          # 百炼硬限制：单次最多 10 条

# ---------- Rerank（Qwen，百炼自有协议）----------
RERANK_ENABLED=true
RERANK_ENDPOINT=https://dashscope.aliyuncs.com/api/v1/services/rerank/text-rerank/text-rerank
RERANK_MODEL=qwen3-rerank

# ---------- 切分 ----------
CHUNK_SIZE=500
CHUNK_OVERLAP=80

# ---------- 两阶段检索 ----------
RETRIEVE_TOP_K=20                # 召回候选数
RERANK_TOP_N=4                   # 重排后送入 LLM 的数量

# ---------- Agent 工具 ----------
AGENT_MAX_STEPS=5                # loop 上限，防死循环烧钱（§19.4）
AGENT_TOOL_RESULT_MAX_CHARS=2000 # 单个工具结果回填前的截断上限（§19.13）
AGENT_ENGINE=handwritten         # handwritten | langgraph（langgraph 需装 requirements-langgraph.txt）

# ---------- Agent 外网工具（批次 B）----------
# 留空时返回明确标注的 mock 结果；填好后走真实 HTTP 调用
WEB_SEARCH_API_KEY=
WEB_SEARCH_ENDPOINT=
WEATHER_API_KEY=
WEATHER_ENDPOINT=

# ---------- MCP（批次 C）----------
# 默认关闭；关闭时进程内不 import mcp
MCP_ENABLED=false
# JSON 数组；示例（去掉行首 # 后生效）：
# MCP_SERVERS=[{"name":"md_writer","command":"python","args":["mcp_servers/md_writer/server.py"]}]
MCP_SERVERS=
EXPORT_DIR=data/exports

# ---------- Skill（批次 D）----------
SKILLS_DIR=skills
SKILL_AUTO_SELECT=true          # 是否允许模型经 load_skill 自动选择

# ---------- 日志 ----------
LOG_LEVEL=INFO                   # DEBUG 会打印每个 chunk / 每条候选的细节

# ---------- 存储 ----------
DATA_DIR=data