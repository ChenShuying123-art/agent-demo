# ---------- Python ----------
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# ---------- Jupyter ----------
.ipynb_checkpoints/

# ---------- 环境变量（含 API Key，严禁提交）----------
.env

# ---------- 运行时数据：只保留目录占位，内容不入库 ----------
data/uploads/*
!data/uploads/.gitkeep
data/index/*
!data/index/.gitkeep

# ---------- Node / Vue 前端 ----------
node_modules/
web/dist/
web/.npm-cache/
*.local

# ---------- 个人材料（要入库）----------
